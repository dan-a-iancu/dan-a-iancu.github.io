{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Hugo Site",
      "type": "shell",
      "command": "./scripts/dev-server.sh",
      "isBackground": true,
      "problemMatcher": [],
      "group": "serve"
    },
    {
      "label": "Build Hugo Site",
      "type": "shell",
      "command": "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:$PATH\" hugo --minify",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
